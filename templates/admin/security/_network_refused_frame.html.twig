{# BearerMail: network_refused.html.twig, inside an admin pane's Turbo frame. #}
<turbo-frame id="{{ frame }}">
    <div class="px-4 py-8 text-center text-sm text-ink-muted">
        <i class="fa-solid fa-house-lock text-2xl text-ink-faint mb-3" aria-hidden="true"></i>
        <p class="font-semibold text-ink mb-1">{{ 'sign_in_protection.refused.heading'|trans }}</p>
        <p>{{ 'sign_in_protection.refused.body'|trans({'%ip%': ip}) }}</p>
    </div>
</turbo-frame>
