{#
notes/edit.html.twig — one note, editable. A checklist is edited as lines,
one item per line, "[x] " in front of a done one; the phone shows the same
items as tick boxes.
#}
{% extends 'contacts/_layout.html.twig' %}
{% import 'notes/_macros.html.twig' as nm %}

{% block title %}{{ note.title ?: 'notes.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block contacts_content %}
    {% set token = csrf_token('notes_' ~ note.id) %}
    {% set trashed = note.trashedAt is not null %}
    {% set checklist = note.items is not empty %}
    {% set bg = '' ~ nm.fill(note.color) %}

    <div class="flex items-center gap-1 px-4 md:px-6 h-14 border-b border-line shrink-0">
        <a href="{{ path('app_notes_list', trashed ? { view: 'trash' } : (note.archived ? { view: 'archive' } : {})) }}"
           class="{{ iconBtn }}" title="{{ 'notes.back'|trans }}" aria-label="{{ 'notes.back'|trans }}">
            <i class="fa-solid fa-arrow-left text-sm" aria-hidden="true"></i>
        </a>
        <h1 class="text-base font-semibold text-ink flex-1 min-w-0 truncate ml-1">{{ note.title ?: 'notes.untitled'|trans }}</h1>
        {% if trashed %}
            {{ nm.actionButton(note, 'restore', 'fa-trash-arrow-up', 'notes.restore', token, null, 'edit') }}
            {{ nm.actionButton(note, 'destroy', 'fa-trash-can', 'notes.delete_forever', token, 'notes.delete_forever_confirm'|trans) }}
        {% else %}
            {{ nm.actionButton(note, 'pin', 'fa-thumbtack', note.pinned ? 'notes.unpin' : 'notes.pin', token, null, 'edit') }}
            {{ nm.actionButton(note, 'archive', note.archived ? 'fa-box-open' : 'fa-box-archive', note.archived ? 'notes.unarchive' : 'notes.archive', token) }}
            {{ nm.actionButton(note, 'trash', 'fa-trash', 'notes.delete', token) }}
        {% endif %}
    </div>

    <div class="flex-1 overflow-y-auto p-4 md:p-6">
        <form method="post" action="{{ path('app_notes_update', { id: note.id }) }}"
              class="max-w-2xl mx-auto rounded-xl border {{ bg ? 'border-black/10 text-[#202124]' : 'border-line bg-surface text-ink' }} p-4 space-y-3"
              {% if bg %}style="background: {{ bg }}"{% endif %}>
            <input type="hidden" name="_token" value="{{ token }}">
            <fieldset {{ trashed ? 'disabled' }} class="space-y-3">
                <input type="text" name="title" maxlength="255" value="{{ note.title }}" placeholder="{{ 'notes.title_placeholder'|trans }}"
                       class="w-full bg-transparent text-lg font-semibold placeholder:opacity-50 focus:outline-none">
                <textarea name="body" rows="14"
                          placeholder="{{ checklist ? 'notes.checklist_placeholder'|trans : 'notes.take_a_note'|trans }}"
                          class="w-full bg-transparent text-sm leading-relaxed placeholder:opacity-50 focus:outline-none resize-y">{% if checklist %}{% for item in note.items %}{{ item.done ? '[x] ' : '' }}{{ item.text }}{{ not loop.last ? "\n" }}{% endfor %}{% else %}{{ note.body }}{% endif %}</textarea>
                <div class="flex flex-wrap items-center gap-3 pt-1 border-t border-black/10">
                    {{ nm.colorPicker(colors, note.color) }}
                    <label class="inline-flex items-center gap-1.5 text-xs cursor-pointer opacity-80">
                        <input type="checkbox" name="checklist" value="1" {{ checklist ? 'checked' }}>
                        {{ 'notes.as_checklist'|trans }}
                    </label>
                    <button type="submit" class="ml-auto inline-flex items-center gap-2 h-8 px-3.5 rounded-lg text-sm font-medium bg-accent hover:bg-accent-strong text-accent-ink cursor-pointer">
                        {{ 'notes.save'|trans }}
                    </button>
                </div>
            </fieldset>
            {% if checklist %}<p class="text-xs opacity-60">{{ 'notes.checklist_hint'|trans }}</p>{% endif %}
            {% if note.links is not empty %}
                <div class="flex flex-wrap gap-1.5 pt-1">
                    {% for link in note.links %}
                        <span class="inline-flex items-center gap-1 h-6 px-2 rounded-full text-xs bg-black/5">
                            <i class="fa-solid {{ nm.linkIcon(link.type) }} text-[10px] opacity-70" aria-hidden="true"></i>
                            {{ link.title ?: ('notes.link_types.' ~ link.type)|trans }}
                        </span>
                    {% endfor %}
                </div>
            {% endif %}
            <p class="text-xs opacity-50">{{ 'notes.edited'|trans({'%when%': note.updatedAt|date('Y-m-d H:i')}) }}</p>
        </form>
    </div>
{% endblock %}
