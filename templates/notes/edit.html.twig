{#
notes/edit.html.twig — one note, laid out like Keep's: the title, then the
text or the checklist, then a toolbar along the bottom (formatting, colour,
checkboxes on/off, link, undo/redo) and Close.

notes--editor saves the whole note as you type. Links are added and removed
with small forms of their own, because they change what the page lists.
#}
{% extends 'contacts/_layout.html.twig' %}
{% import 'notes/_macros.html.twig' as nm %}

{% block title %}{{ note.title ?: 'notes.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block contacts_content %}
    {% set token = csrf_token('notes_' ~ note.id) %}
    {% set trashed = note.trashedAt is not null %}
    {% set checklist = note.items is not empty %}
    {% set bg = '' ~ nm.fill(note.color) %}
    {% set palette = {} %}
    {% for c in colors %}{% set palette = palette|merge({ (c): '' ~ nm.fill(c) }) %}{% endfor %}

    <div class="flex items-center gap-1 px-4 md:px-6 h-14 border-b border-line shrink-0">
        <h1 class="text-base font-semibold text-ink flex-1 min-w-0 truncate">{{ note.title ?: 'notes.untitled'|trans }}</h1>
        {% if trashed %}
            {{ nm.actionButton(note, 'restore', 'fa-trash-arrow-up', 'notes.restore', token, null, 'edit') }}
            {{ nm.actionButton(note, 'destroy', 'fa-trash-can', 'notes.delete_forever', token, 'notes.delete_forever_confirm'|trans) }}
        {% else %}
            {{ nm.actionButton(note, 'archive', note.archived ? 'fa-box-open' : 'fa-box-archive', note.archived ? 'notes.unarchive' : 'notes.archive', token) }}
            {{ nm.actionButton(note, 'trash', 'fa-trash', 'notes.delete', token) }}
        {% endif %}
    </div>

    <div class="flex-1 overflow-y-auto p-4 md:p-6">
        <div class="max-w-2xl mx-auto rounded-xl border shadow-sm {{ bg ? 'border-black/10 text-[#202124]' : 'border-line bg-surface text-ink' }}"
             data-controller="notes--editor"
             data-notes--editor-url-value="{{ path('app_notes_autosave', { id: note.id }) }}"
             data-notes--editor-token-value="{{ token }}"
             data-notes--editor-palette-value="{{ palette|json_encode }}"
             data-notes--editor-saving-value="{{ 'notes.saving'|trans }}"
             data-notes--editor-saved-value="{{ 'notes.saved'|trans }}"
             data-notes--editor-failed-value="{{ 'notes.save_failed'|trans }}"
             data-notes--editor-item-placeholder-value="{{ 'notes.list_item'|trans }}"
             {% if bg %}style="background: {{ bg }}"{% endif %}>

            <div class="flex items-start gap-2 px-4 pt-3">
                <input type="text" maxlength="255" value="{{ note.title }}" placeholder="{{ 'notes.title_placeholder'|trans }}"
                       data-notes--editor-target="title" data-action="input->notes--editor#changed"
                       {{ trashed ? 'disabled' }}
                       class="flex-1 min-w-0 bg-transparent text-lg font-semibold placeholder:opacity-50 focus:outline-none">
                {% if not trashed %}
                    {{ nm.actionButton(note, 'pin', 'fa-thumbtack', note.pinned ? 'notes.unpin' : 'notes.pin', token, null, 'edit', note.pinned) }}
                {% endif %}
            </div>

            {# Text mode #}
            <div class="px-4 pb-2 {{ checklist ? 'hidden' }}" data-notes--editor-target="textPane">
                <textarea rows="10" placeholder="{{ 'notes.take_a_note'|trans }}"
                          data-notes--editor-target="body" data-action="input->notes--editor#changed"
                          {{ trashed ? 'disabled' }}
                          class="w-full bg-transparent text-sm leading-relaxed placeholder:opacity-50 focus:outline-none resize-y">{{ note.body }}</textarea>
            </div>

            {# Checklist mode #}
            <div class="px-2 pb-2 {{ not checklist ? 'hidden' }}" data-notes--editor-target="listPane">
                <ul data-notes--editor-target="items" class="space-y-0.5">
                    {% for item in note.items %}
                        <li data-item class="flex items-center gap-2 px-2 rounded hover:bg-black/5">
                            <input type="checkbox" data-done {{ item.done ? 'checked' }} {{ trashed ? 'disabled' }}
                                   data-action="change->notes--editor#changed" class="shrink-0">
                            <input type="text" data-text value="{{ item.text }}" maxlength="1000" {{ trashed ? 'disabled' }}
                                   placeholder="{{ 'notes.list_item'|trans }}"
                                   data-action="input->notes--editor#changed keydown->notes--editor#itemKey"
                                   class="flex-1 min-w-0 bg-transparent py-1 text-sm focus:outline-none {{ item.done ? 'line-through opacity-60' }}">
                            <button type="button" data-action="notes--editor#removeItem" title="{{ 'notes.remove_item'|trans }}"
                                    class="w-7 h-7 opacity-50 hover:opacity-100 cursor-pointer" {{ trashed ? 'hidden' }}>
                                <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                            </button>
                        </li>
                    {% endfor %}
                </ul>
                {% if not trashed %}
                    <label class="flex items-center gap-2 px-2 py-1 text-sm opacity-70">
                        <i class="fa-solid fa-plus text-xs w-[13px]" aria-hidden="true"></i>
                        <input type="text" placeholder="{{ 'notes.list_item'|trans }}" data-notes--editor-target="newItem"
                               data-action="input->notes--editor#addItem"
                               class="flex-1 bg-transparent py-1 focus:outline-none">
                    </label>
                {% endif %}
            </div>

            {# Labels and links #}
            <div class="px-4 pb-2 space-y-2">
                <input type="text" value="{{ note.labels|join(', ') }}" placeholder="{{ 'notes.labels_placeholder'|trans }}"
                       data-notes--editor-target="labels" data-action="input->notes--editor#changed"
                       {{ trashed ? 'disabled' }}
                       class="w-full bg-transparent text-xs placeholder:opacity-50 focus:outline-none">
                {% if note.links is not empty %}
                    <div class="flex flex-wrap gap-1.5">
                        {% for link in note.links %}
                            <span class="inline-flex items-center gap-1 h-7 pl-2 pr-1 rounded-full text-xs bg-black/5 max-w-full">
                                <i class="fa-solid {{ nm.linkIcon(link.type) }} text-[10px] opacity-70" aria-hidden="true"></i>
                                {% set href = nm.linkHref(link) ~ '' %}
                                {% if href %}
                                    <a href="{{ href }}" class="truncate hover:underline">{{ link.title ?: ('notes.link_types.' ~ link.type)|trans }}</a>
                                {% else %}
                                    <span class="truncate">{{ link.title ?: ('notes.link_types.' ~ link.type)|trans }}</span>
                                {% endif %}
                                {% if not trashed %}
                                    <form method="post" action="{{ path('app_notes_unlink', { id: note.id }) }}">
                                        <input type="hidden" name="_token" value="{{ token }}">
                                        <input type="hidden" name="type" value="{{ link.type }}">
                                        <input type="hidden" name="link_id" value="{{ link.id }}">
                                        <button type="submit" class="w-5 h-5 rounded-full hover:bg-black/10 cursor-pointer" title="{{ 'notes.unlink'|trans }}" aria-label="{{ 'notes.unlink'|trans }}">
                                            <i class="fa-solid fa-xmark text-[10px]" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {% if not trashed %}
                {# Colour row, shown by the palette button #}
                <div class="hidden px-4 pb-2" data-notes--editor-target="colorRow">
                    {{ nm.colorPicker(colors, note.color, 'change->notes--editor#colorChanged') }}
                </div>

                {# Link picker, shown by the link button #}
                <form method="post" action="{{ path('app_notes_link', { id: note.id }) }}"
                      class="hidden px-4 pb-2 flex items-center gap-2" data-notes--editor-target="linkRow">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <select name="target" class="flex-1 min-w-0 h-8 rounded-lg border border-black/15 bg-white/60 text-sm px-2">
                        {% if contacts is not empty %}
                            <optgroup label="{{ 'notes.link_types.contact'|trans }}">
                                {% for c in contacts %}
                                    <option value="contact|{{ c.id }}|{{ c.displayName }}">{{ c.displayName }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endif %}
                        {% if events is not empty %}
                            <optgroup label="{{ 'notes.link_types.event'|trans }}">
                                {% for e in events %}
                                    <option value="event|{{ e.id }}|{{ e.title }}">{{ e.startsAt ? e.startsAt|date('Y-m-d') ~ ' · ' }}{{ e.title }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endif %}
                    </select>
                    <button type="submit" class="h-8 px-3 rounded-lg text-sm font-medium bg-black/10 hover:bg-black/15 cursor-pointer">{{ 'notes.add_link'|trans }}</button>
                </form>

                {# Toolbar #}
                <div class="flex flex-wrap items-center gap-0.5 px-2 pb-2">
                    {% for mark, spec in {
                        '**': ['fa-bold', 'notes.format.bold'],
                        '*': ['fa-italic', 'notes.format.italic'],
                        '__': ['fa-underline', 'notes.format.underline'],
                        '# ': ['fa-heading', 'notes.format.heading'],
                        '- ': ['fa-list-ul', 'notes.format.bullets'],
                    } %}
                        <button type="button" data-action="notes--editor#format" data-notes--editor-mark-param="{{ mark }}"
                                data-notes--editor-target="formatButton"
                                class="w-9 h-9 rounded-full hover:bg-black/10 cursor-pointer {{ checklist ? 'hidden' }}"
                                title="{{ spec[1]|trans }}" aria-label="{{ spec[1]|trans }}">
                            <i class="fa-solid {{ spec[0] }} text-sm" aria-hidden="true"></i>
                        </button>
                    {% endfor %}
                    <button type="button" data-action="notes--editor#toggleColors" class="w-9 h-9 rounded-full hover:bg-black/10 cursor-pointer"
                            title="{{ 'notes.color'|trans }}" aria-label="{{ 'notes.color'|trans }}">
                        <i class="fa-solid fa-palette text-sm" aria-hidden="true"></i>
                    </button>
                    <button type="button" data-action="notes--editor#toggleChecklist" class="w-9 h-9 rounded-full hover:bg-black/10 cursor-pointer"
                            data-notes--editor-target="checklistButton"
                            data-show-label="{{ 'notes.show_checkboxes'|trans }}" data-hide-label="{{ 'notes.hide_checkboxes'|trans }}"
                            title="{{ checklist ? 'notes.hide_checkboxes'|trans : 'notes.show_checkboxes'|trans }}"
                            aria-label="{{ checklist ? 'notes.hide_checkboxes'|trans : 'notes.show_checkboxes'|trans }}">
                        <i class="fa-regular fa-square-check text-sm" aria-hidden="true"></i>
                    </button>
                    <button type="button" data-action="notes--editor#toggleLinks" class="w-9 h-9 rounded-full hover:bg-black/10 cursor-pointer"
                            title="{{ 'notes.add_link'|trans }}" aria-label="{{ 'notes.add_link'|trans }}">
                        <i class="fa-solid fa-link text-sm" aria-hidden="true"></i>
                    </button>
                    <button type="button" data-action="notes--editor#undo" data-notes--editor-target="undoButton" disabled
                            class="w-9 h-9 rounded-full hover:bg-black/10 cursor-pointer disabled:opacity-30 disabled:cursor-default"
                            title="{{ 'notes.undo'|trans }}" aria-label="{{ 'notes.undo'|trans }}">
                        <i class="fa-solid fa-rotate-left text-sm" aria-hidden="true"></i>
                    </button>
                    <button type="button" data-action="notes--editor#redo" data-notes--editor-target="redoButton" disabled
                            class="w-9 h-9 rounded-full hover:bg-black/10 cursor-pointer disabled:opacity-30 disabled:cursor-default"
                            title="{{ 'notes.redo'|trans }}" aria-label="{{ 'notes.redo'|trans }}">
                        <i class="fa-solid fa-rotate-right text-sm" aria-hidden="true"></i>
                    </button>
                    <span class="ml-2 text-xs opacity-60" data-notes--editor-target="status" aria-live="polite"></span>

                    <form method="post" action="{{ path('app_notes_close', { id: note.id }) }}" class="ml-auto"
                          data-action="submit->notes--editor#close">
                        <input type="hidden" name="_token" value="{{ token }}">
                        {% if returnTo %}<input type="hidden" name="return" value="{{ returnTo }}">{% endif %}
                        <button type="submit" class="h-9 px-4 rounded-lg text-sm font-semibold hover:bg-black/10 cursor-pointer">{{ 'notes.close'|trans }}</button>
                    </form>
                </div>
            {% else %}
                <div class="px-4 pb-3">
                    <a href="{{ path('app_notes_list', { view: 'trash' }) }}" class="text-sm font-semibold hover:underline">{{ 'notes.close'|trans }}</a>
                </div>
            {% endif %}

            <p class="px-4 pb-3 text-xs opacity-50">{{ 'notes.edited'|trans({'%when%': note.updatedAt|date('Y-m-d H:i')}) }}</p>

            <template data-notes--editor-target="itemTemplate">
                <li data-item class="flex items-center gap-2 px-2 rounded hover:bg-black/5">
                    <input type="checkbox" data-done data-action="change->notes--editor#changed" class="shrink-0">
                    <input type="text" data-text maxlength="1000" placeholder="{{ 'notes.list_item'|trans }}"
                           data-action="input->notes--editor#changed keydown->notes--editor#itemKey"
                           class="flex-1 min-w-0 bg-transparent py-1 text-sm focus:outline-none">
                    <button type="button" data-action="notes--editor#removeItem" title="{{ 'notes.remove_item'|trans }}"
                            class="w-7 h-7 opacity-50 hover:opacity-100 cursor-pointer">
                        <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                    </button>
                </li>
            </template>
        </div>
    </div>
{% endblock %}
