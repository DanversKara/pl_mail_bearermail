{# mail/_message_content.html.twig #}
{# White sheet across the pane, same as the thread view. #}
<div class="mail-sheet flex flex-col flex-1 min-h-0">

<div class="flex items-center gap-2 px-4 py-2 border-b border-line">
    <button
        type="button"
        data-action="click->mail--mail-pane#close"
        aria-label="{{ 'message.back'|trans }}"
        class="p-2 rounded-lg text-ink-muted hover:text-ink hover:bg-hover transition-colors"
    >
        <i class="fa-solid fa-arrow-left w-4 h-4" aria-hidden="true"></i>
    </button>
    {# Gmail-style accounts are label-only, so mailbox is null — fall back to the account. #}
    <span class="text-sm text-ink-faint truncate">
        {{ message.mailbox ? message.mailbox.name : message.thread.account.email }}
    </span>
</div>

<div class="flex-1 overflow-y-auto">
    {# The same division the conversation view makes: the bar above holds still
       and the mail arrives. This pane is swapped in wholesale by
       mail--mail-pane#_loadMessage every time a row is opened, so the fade is
       exactly one per click — and it is a fade rather than the conversation's
       rise because there is only one thing here, and a page-sized surface that
       travels reads as the pane sliding rather than as a mail appearing. #}
    <div data-enter="fade" class="w-full px-4 md:px-6 py-5">

        <h1 class="text-xl font-semibold text-ink mb-4">
            {{ message.subject ?: ('thread.no_subject'|trans) }}
        </h1>

        {# Forged sender warning: the receiving server checked SPF/DKIM/DMARC
           and the From domain did not pass. A believed Authentication-Results
           header says so — see App\Service\Mail\SenderAuthentication. #}
        {% if senderVerdict is defined and senderVerdict.value == 'fail' %}
            <div class="mb-4 px-4 py-3 rounded-lg bg-red-500/10 border border-red-500/30 flex items-start gap-3">
                <i class="fa-solid fa-triangle-exclamation text-red-500 mt-0.5" aria-hidden="true"></i>
                <div class="text-[13px]">
                    <p class="font-semibold text-red-600">{{ 'message.forged_sender.title'|trans }}</p>
                    <p class="text-ink-muted mt-0.5">{{ 'message.forged_sender.body'|trans }}</p>
                </div>
            </div>
        {% endif %}

        {# Deceptive link warning: a link's text claims one destination but its
           href goes elsewhere — the classic phish. See
           App\Service\Mail\DeceptiveLinkChecker. #}
        {% if deceptiveLinks is defined and deceptiveLinks is not empty %}
            <div class="mb-4 px-4 py-3 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-start gap-3">
                <i class="fa-solid fa-link-slash text-amber-600 mt-0.5" aria-hidden="true"></i>
                <div class="text-[13px]">
                    <p class="font-semibold text-amber-700">{{ 'message.deceptive_link.title'|trans }}</p>
                    <p class="text-ink-muted mt-0.5">{{ 'message.deceptive_link.body'|trans }}</p>
                    <ul class="mt-2 space-y-1">
                        {% for link in deceptiveLinks|slice(0, 3) %}
                            <li class="font-mono text-xs">
                                <span class="text-ink">{{ link.textDomain }}</span>
                                <i class="fa-solid fa-arrow-right mx-1 text-ink-faint" aria-hidden="true"></i>
                                <span class="text-red-600">{{ link.hrefDomain }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}

        {# Sticky within this pane's scroller (H-14) — same reasoning as the
           conversation view: sender and date stay put while the mail moves.
           min-w-0 on the inner column is the recipient line's truncation. #}
        <div class="flex items-start justify-between border-b border-line pb-4 mb-4 sticky top-0 z-10 bg-surface pt-1 -mt-1">
            <div class="min-w-0">
                <p class="text-sm font-medium text-ink">
                    {{ message.fromName ?: message.fromAddress }}
                </p>
                <p class="text-xs text-ink-faint">
                    {{ message.fromAddress }}
                </p>
                {# The same header the thread view shows, for the same reason:
                   this view named the sender and nobody else, so who the mail
                   was addressed to was not on the page at all. #}
                {% include 'mail/_message_details.html.twig' with { message: message } only %}
            </div>
            <p class="text-xs text-ink-faint flex-shrink-0">
                {# Sent mail shows its sentAt: it has no receivedAt to show. #}
                {% set shownAt = message.receivedAt ?? message.sentAt %}
                {{ shownAt ? shownAt|intl_date('dMMMy') ~ ', ' ~ shownAt|date(clock.time) : '' }}
            </p>
        </div>

        {# What plMail read out of this conversation, before the conversation. #}
        {% include 'mail/_insight_strip.html.twig' with { insights: insights|default([]) } only %}

        {# Attachments above the body (H-13) — see _thread_message for why. #}
        {% if message.hasAttachments %}
            <div class="flex flex-wrap items-center gap-2 mb-4">
                <span class="text-xs font-medium text-ink-faint">{{ 'message.attachments'|trans }}</span>
                {% for part in message.messageParts %}
                    {% if not part.isInline %}
                        {% include 'mail/_attachment_chip.html.twig' with { part: part } %}
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

        {% include 'mail/_message_body.html.twig' with { message: message } only %}

    </div>
</div>

</div>{# /mail-sheet #}
