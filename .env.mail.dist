# Template for .env.mail.local (copy it, fill it in). The .local copy is
# ignored by git and kept out of the Docker image. compose.yaml hands it to
# the php, worker, mta and mailstore containers.
#

MAIL_DOMAIN=bearermail.com
MAIL_HELO=mail.bearermail.com
# localpart:password pairs, comma-separated. Logins are localpart@MAIL_DOMAIN.
MAIL_ACCOUNTS=
# Extra addresses delivered into an existing mailbox, alias:mailbox pairs.
# e.g. MAIL_ALIASES=sales:support,billing:support (also lets support send as them).
MAIL_ALIASES=
# Your server's public IPv4, used by Admin -> Mail server -> Check DNS (SPF).
SERVER_IP=

# Outbound relay (Mailjet). Admin -> Mail server can override these.
MAIL_RELAYHOST=[in-v3.mailjet.com]:587
MAIL_RELAY_USER=
MAIL_RELAY_PASS=

# Dynamic DNS (Cloudflare) for app:mail:update-dynamic-dns
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DYNAMIC_DNS_HOSTS=mail.bearermail.com

# Drive quota per user, in MB (0 = unlimited)
DRIVE_QUOTA_MB=5120

# BearerMail: block addresses that keep getting the password wrong on IMAP
# (port 993). Settings and Unblock are in Admin -> Security. "off" disables it.
#MAIL_LOGIN_GUARD=on
